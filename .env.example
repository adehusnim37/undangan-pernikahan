# Runtime
APP_ENV=development
PORT=3020
NEXT_PUBLIC_APP_URL=http://localhost:3020
# Set TRUST_PROXY=true hanya bila aplikasi hanya bisa diakses lewat nginx
# (lihat deploy/nginx). Rate-limit berbasis IP memakai X-Forwarded-For.
TRUST_PROXY=false

# PostgreSQL
# Jika PostgreSQL berjalan di host mesin saat aplikasi memakai Docker,
# ganti localhost menjadi host.docker.internal.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/undangan
AUTO_MIGRATE=true

# Admin login. USER_ADMIN dan PASSWORD_ADMIN dipasangkan sesuai urutan.
# Jangan gunakan koma di dalam password; gunakan minimal 15 karakter per akun.
USER_ADMIN=admin@undangan.local,pengelola@example.com
PASSWORD_ADMIN=ganti-password-ini,ganti-password-kedua
SESSION_SECRET=ganti-dengan-random-string-panjang

# Email OTP admin (port 587 memakai STARTTLS; port 465 memakai TLS langsung)
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
SMTP_USER=emailapikey
SMTP_PASS=ganti-dengan-smtp-api-key
FROM_EMAIL=no-reply@lihat.in
FROM_NAME=Lihatin

# Public brand settings (nama mempelai untuk landing, admin, dan undangan)
NEXT_PUBLIC_COUPLE_NAME=Alvita & Ade
NEXT_PUBLIC_BRIDE_NAME=Alvita
NEXT_PUBLIC_GROOM_NAME=Ade

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=undangan-images
R2_PUBLIC_BASE_URL=https://images.example.com
