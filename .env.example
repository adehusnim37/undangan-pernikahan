# Runtime
APP_ENV=development
PORT=3020

# PostgreSQL
# Jika PostgreSQL berjalan di host mesin saat aplikasi memakai Docker,
# ganti localhost menjadi host.docker.internal.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/undangan

# Admin login (use a long unique password outside local development)
ADMIN_EMAIL=admin@undangan.local
ADMIN_PASSWORD=ganti-password-ini
SESSION_SECRET=ganti-dengan-random-string-panjang

# Public brand settings
NEXT_PUBLIC_COUPLE_NAME=Aruna & Bima

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=undangan-images
R2_PUBLIC_BASE_URL=https://images.example.com
