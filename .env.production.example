# File ini dipakai dengan: $env:ENV_FILE='.env.production'
# lalu docker compose --env-file .env.production up -d --build
ENV_FILE=.env.production

# Port aplikasi Next.js dan port host Docker
PORT=8080

# PostgreSQL eksternal
DATABASE_URL=postgres://user:password@host.docker.internal:5432/undangan

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-dengan-password-produksi-yang-kuat
SESSION_SECRET=ganti-dengan-random-string-produksi-yang-panjang

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=undangan-images
R2_PUBLIC_BASE_URL=https://images.example.com
